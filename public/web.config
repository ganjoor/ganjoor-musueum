<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Default cache policy for everything in this site: 30 days.
         Covers the unhashed files Vue CLI copies verbatim from /public
         (favicon*.png, apple-touch-icon.png, android-chrome-*.png,
         site.webmanifest, browserconfig.xml) - these rarely change and
         currently have no cache header at all, hence the repeated
         full re-downloads seen in the IIS logs. -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="30.00:00:00" />
    </staticContent>

    <!-- Serve compressed text assets (js/css/html) if the IIS compression
         module is installed on the server - check with whoever manages the
         server if this doesn't seem to be taking effect. -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <rewrite>
      <rules>
        <rule name="Handle History Mode and custom 404/500" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/" />
        </rule>
      </rules>
    </rewrite>

  </system.webServer>

  <!-- index.html must always be revalidated: it's the file that points
       browsers at the CURRENT hashed js/css bundle names. Caching this
       long would mean visitors keep loading an old index.html that
       references bundle files from a previous build. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
      <httpProtocol>
        <customHeaders>
          <remove name="Cache-Control" />
          <add name="Cache-Control" value="no-cache, must-revalidate" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>

  <!-- Webpack output: filenames are content-hashed (e.g. chunk-vendors.65550242.js),
       so a rebuild always produces new filenames. Safe to cache for a full year -
       this is the block that should kill most of the repeated crawler downloads
       seen in the logs (chunk-vendors.js, chunk-vendors.css, Material Design Icons
       woff2, Samim fonts, app.js). -->
  <location path="js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="css">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="fonts">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
  <location path="img">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>
